# Copy to .env and fill in real values. Never commit .env.

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Set to 1 when running behind a reverse proxy so rate limits see real client IPs
TRUST_PROXY=
# Frontend origin, used for CORS and links in emails
FRONTEND_URL=http://localhost:5173

# ---------- PostgreSQL (needs the pgvector extension) ----------
PGHOST=localhost
PGPORT=5432
PGDATABASE=gradix
PGUSER=gradix
PGPASSWORD=change-me
# "disable" for a local database without TLS; anything else uses TLS
PGSSLMODE=require
# Optional connection pool size
PGPOOL_MAX=10

# ---------- Auth ----------
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret
# Google reCAPTCHA v3 secret (server side)
RECAPTCHA_SECRET_KEY=your-recaptcha-secret

# Firebase Admin service account (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Keep the quotes; newlines in the key must be written as \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ---------- Email (Gmail SMTP with an app password) ----------
EMAIL_USER=you@example.com
EMAIL_PASS=your-gmail-app-password

# ---------- AI providers ----------
# Add as many keys as you have: GEMINI_CREATION_API_KEY_1, _2, _3, ... and GROQ_API_KEY, GROQ_API_KEY_2, ...
# Calls are shuffled over every key that still has free quota today; a key that hits its
# limit is skipped until it resets. Free limits count per Google project / Groq account,
# so keys from different accounts add capacity.
GEMINI_CREATION_API_KEY_1=your-gemini-key
GEMINI_CREATION_API_KEY_2=
GROQ_API_KEY=
GROQ_API_KEY_2=
GEMINI_CHECKING_API_KEY=your-gemini-key-for-recommendations

# ---------- Optional ----------
# Path to a Chromium binary for Puppeteer PDF generation (servers without bundled Chromium)
PUPPETEER_EXECUTABLE_PATH=

# ---------- Seeding (scripts/createSuperAdmin.js and npm run seed) ----------
SUPERADMIN_NAME=Super Administrator
SUPERADMIN_EMAIL=superadmin@example.com
# 8+ chars with upper, lower and a digit (createSuperAdmin also requires 12+)
SUPERADMIN_PASSWORD=
# npm run seed: password shared by the seeded admin, instructor and student
SEED_PASSWORD=
# Optional; seeded accounts are admin@, instructor@ and student@ this domain
SEED_EMAIL_DOMAIN=example.com

# ---------- Background jobs (pg-boss, uses the same Postgres) ----------
# The API runs the jobs itself (objectives, question pools...). Set JOBS_IN_API=false only
# if you run `npm run worker` as a separate process instead.
JOBS_IN_API=true
# Parallel jobs per worker process
WORKER_CONCURRENCY=2
# Postgres connections used by the job queue (per process)
JOB_POOL_MAX=4
# Days to keep rows in llm_usage_log
LLM_LOG_RETENTION_DAYS=365

# Retrieval embeddings (Phase 2). Multilingual model, runs locally; downloaded once (~120 MB).
EMBEDDING_MODEL=Xenova/multilingual-e5-small
# Optional: where the model files are cached (default: inside node_modules).
EMBEDDING_CACHE_DIR=
# Max time a student waits for an on-demand question when a pool bucket is empty (ms)
POOL_ON_DEMAND_TIMEOUT_MS=20000

# OCR: when Tesseract output is unusable, send the page images to Gemini for transcription.
# Off by default because it sends document images to an external service.
OCR_GEMINI_FALLBACK=false

# Optional: your free-plan limits per model, shown on the Super Admin dashboard and used to
# rotate keys (rpm/rpd = requests per minute/day, tpm/tpd = tokens per minute/day).
# Defaults: gemini-2.5-flash rpm 10, rpd 250; openai/gpt-oss-20b rpm 30, rpd 1000, tpd 200000.
# LLM_FREE_LIMITS_JSON={"gemini-2.5-flash":{"rpd":250},"openai/gpt-oss-20b":{"tpd":200000}}
LLM_FREE_LIMITS_JSON=
