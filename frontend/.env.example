# Copy to .env and fill in real values. Never commit .env.
# Everything here is bundled into the browser build, so only public values belong here.

# Backend API base URL (including /api)
VITE_API_URL=http://localhost:5000/api

# Firebase web app config (Project settings > General > Your apps)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:replace-me

# Google reCAPTCHA v3 site key (public)
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
